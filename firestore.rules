rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Quản lý = email đã đăng nhập nằm trong config/staff.emails
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function isStaff() {
      return signedIn() &&
        request.auth.token.email.lower() in
          get(/databases/$(database)/documents/config/staff).data.emails;
    }

    // Danh sách quản lý: người đã đăng nhập đọc được để biết mình có quyền không.
    // Chỉ sửa trong Firebase console.
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Hồ sơ công khai: khách chỉ đọc được idol đã bật hiển thị.
    match /idols/{id} {
      allow read: if resource.data.public == true || isStaff();
      allow write: if isStaff();
    }
    // Ảnh to cho khung lớn trên lineup: khách chỉ tải khi chọn promoter, chỉ đọc được người đang hiển thị.
    match /idolPhotos/{id} {
      allow read: if resource.data.public == true || isStaff();
      allow write: if isStaff();
    }
    // Hồ sơ đầy đủ (số đo bị ẩn, giấy đồng ý): chỉ quản lý.
    match /idolsPrivate/{id} {
      allow read, write: if isStaff();
    }

    // Điểm sao và tag khen: công khai để tính bảng xếp hạng. Chỉ tablet của quán ghi.
    match /reviews/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    // Ẩn review rác: công khai để mọi người tính cùng một điểm.
    match /moderation/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Lời nhắn, tag góp ý, tip: chỉ quản lý.
    match /notes/{id} { allow read, write: if isStaff(); }
    // Sơ đồ bàn (venue/tables { list: [...] }): chỉ quản lý.
    match /venue/{id} { allow read, write: if isStaff(); }
    match /bills/{id} { allow read, write: if isStaff(); }
    match /redeemed/{id} { allow read, write: if isStaff(); }

    // Bàn đã có người đặt trong ngày: tableHolds/{ngày}_{bàn} { date, table, bookingId, createdAt, until, seated }.
    // Ai cũng đọc được để làm tối bàn trên sơ đồ (không có tên, số điện thoại).
    // until = giờ hết giữ bàn (giờ VN = UTC+7): 22h30 ngày đặt; giờ đến sau 22h30 thì giờ đến + 35 phút;
    // đặt muộn sau 22h30 thì lúc gửi + 35 phút.
    // Khách chỉ ghi cùng lúc với đặt bàn của chính mình: tạo mới, hoặc ghi đè bàn đã quá giờ giữ mà quản lý chưa xếp khách vào.
    function dayMs(date) {
      let p = date.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2])).toMillis();
    }
    function cutoffMs(date) { return dayMs(date) + 930 * 60000; }
    // giờ đến + 35 phút; giờ đọc theo 24 giờ của đúng ngày đặt
    function arrivalHold(date, time, until) {
      let t = time.split(':');
      return until == dayMs(date) + (int(t[0]) * 60 + int(t[1]) - 420 + 35) * 60000;
    }
    function guestHold(id) {
      let h = request.resource.data;
      let b = getAfter(/databases/$(database)/documents/bookings/$(h.bookingId)).data;
      return h.keys().hasOnly(['date','table','bookingId','createdAt','until']) &&
        h.date is string && h.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        h.table is string && h.table.matches('^[A-Z]{1,3}[0-9]{1,2}$') &&
        h.bookingId is string && h.bookingId.size() <= 40 &&
        h.createdAt is number &&
        h.until is number &&
        (h.until == cutoffMs(h.date) ||
          (h.until > request.time.toMillis() && h.until <= request.time.toMillis() + 36 * 60000) ||
          (b.time is string && b.time.matches('^[0-9]{1,2}:[0-9]{2}$') && arrivalHold(h.date, b.time, h.until))) &&
        id == h.date + '_' + h.table &&
        b.table == h.table && b.date == h.date && b.status == 'requested' && b.holdUntil == h.until;
    }
    match /tableHolds/{id} {
      allow read: if true;
      allow delete: if isStaff();
      allow create: if isStaff() || guestHold(id);
      allow update: if isStaff() || (
        resource.data.get('seated', false) != true &&
        resource.data.get('until', null) is number &&
        resource.data.until < request.time.toMillis() &&
        guestHold(id)
      );
    }

    // Lượt mở trang theo ngày: visits/{ngày} { date, n }. Khách chỉ được tạo với n = 1 hoặc cộng thêm đúng 1.
    // Không có thông tin khách. Chỉ quản lý đọc (để ước tính dung lượng tải ra so với 10 GB/tháng miễn phí).
    match /visits/{d} {
      // chỉ là số lượt mở theo ngày, không có thông tin khách: mở đọc công khai để lịch kiểm tra hằng ngày theo dõi dung lượng (anh Minh 08/11)
      allow read: if true;
      allow delete: if isStaff();
      allow create: if d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.keys().hasOnly(['date', 'n']) &&
        request.resource.data.date == d && request.resource.data.n == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n']) &&
        request.resource.data.n == resource.data.n + 1;
    }

    // Số khách đặt trước đã xác nhận theo ngày: idolLoad/{ngày} { date, counts: { idolId: số }, updatedAt }.
    // Chỉ có con số theo promoter, không tên hay số điện thoại khách, nên ai cũng đọc được. Chỉ quản lý ghi.
    match /idolLoad/{d} {
      allow read: if true;
      allow delete: if isStaff();
      allow create, update: if isStaff() &&
        request.resource.data.keys().hasOnly(['date', 'counts', 'updatedAt']) &&
        request.resource.data.date == d &&
        request.resource.data.counts is map;
    }

    // Tên DJ từng đêm cho tờ rơi đầu trang: tonight/{ngày} { date, dj, updatedAt }.
    // Ai cũng đọc được (chỉ là tên DJ). Chỉ quản lý ghi, đúng khuôn, tên tối đa 60 ký tự.
    match /tonight/{d} {
      allow read: if true;
      allow delete: if isStaff();
      allow create, update: if isStaff() &&
        d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.keys().hasOnly(['date', 'dj', 'updatedAt']) &&
        request.resource.data.date == d &&
        request.resource.data.dj is string && request.resource.data.dj.size() > 0 && request.resource.data.dj.size() <= 60 &&
        request.resource.data.updatedAt is number;
    }

    // Đặt bàn: khách gửi yêu cầu (chỉ tạo mới, đúng khuôn), quản lý đọc và xử lý.
    match /bookings/{id} {
      allow read, update, delete: if isStaff();
      allow create: if isStaff() || (
        request.resource.data.keys().hasOnly(['salutation','guestName','phone','date','time','guests','table','idolIds','note','status','source','code','createdAt','holdUntil']) &&
        request.resource.data.status == 'requested' &&
        request.resource.data.source == 'web' &&
        request.resource.data.code == '' &&
        (request.resource.data.table == '' || (
          request.resource.data.table is string && request.resource.data.table.matches('^[A-Z]{1,3}[0-9]{1,2}$') &&
          getAfter(/databases/$(database)/documents/tableHolds/$(request.resource.data.date + '_' + request.resource.data.table)).data.bookingId == id)) &&
        request.resource.data.guestName is string && request.resource.data.guestName.size() > 0 && request.resource.data.guestName.size() <= 40 &&
        request.resource.data.phone is string && request.resource.data.phone.matches('^[0-9]{9,11}$') &&
        request.resource.data.date is string && request.resource.data.date.size() == 10 &&
        request.resource.data.time is string && request.resource.data.time.size() <= 5 &&
        request.resource.data.guests is string && request.resource.data.guests.size() <= 3 &&
        request.resource.data.note is string && request.resource.data.note.size() <= 160 &&
        request.resource.data.idolIds is list && request.resource.data.idolIds.size() <= 6 &&
        request.resource.data.createdAt is number &&
        (!('salutation' in request.resource.data) || request.resource.data.salutation in ['Mr','Miss']) &&
        (!('holdUntil' in request.resource.data) || request.resource.data.holdUntil is number)
      );
    }
  }
}
